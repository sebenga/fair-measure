# ---------------------------------------------------------------------------
# Fair Measure v2 — copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200

# --- PostgreSQL ------------------------------------------------------------
# Leave DATABASE_URL unset to fall back to SQLite for zero-dependency local dev.
DATABASE_URL=postgres://fairmeasure:fairmeasure@localhost:5432/fairmeasure
POSTGRES_DB=fairmeasure
POSTGRES_USER=fairmeasure
POSTGRES_PASSWORD=fairmeasure

# --- Redis (cache, pub/sub, BullMQ) ----------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth ------------------------------------------------------------------
# ACCESS/REFRESH lifetimes are in minutes / days respectively.
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=14
# Signing key shared with the realtime service so it can verify sockets.
JWT_SIGNING_KEY=change-me-to-a-long-random-string

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Object storage (S3-compatible: Cloudflare R2 or AWS S3) ---------------
# STORAGE_PROVIDER: r2 | s3
STORAGE_PROVIDER=r2
STORAGE_BUCKET=fair-measure-media
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# R2 only: https://<account_id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT_URL=
# Public CDN base used to build read URLs, e.g. https://media.fairmeasure.app
STORAGE_PUBLIC_BASE_URL=

# --- Video (Cloudflare Stream or Mux) --------------------------------------
# VIDEO_PROVIDER: cloudflare_stream | mux
VIDEO_PROVIDER=cloudflare_stream
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# --- Push notifications (Firebase Cloud Messaging) -------------------------
# Absolute path to the service-account JSON, or paste the JSON into
# FIREBASE_CREDENTIALS_JSON. Leave both blank to no-op push in development.
FIREBASE_CREDENTIALS_FILE=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# --- Search (Meilisearch, phase 2) -----------------------------------------
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=
SEARCH_ENABLED=false

# --- Realtime / worker service (Node) --------------------------------------
REALTIME_PORT=4000
REALTIME_CORS_ORIGINS=http://localhost:8100,http://localhost:4200
# Shared secret for Django -> realtime internal HTTP calls.
INTERNAL_API_TOKEN=change-me-to-a-long-random-string
# Base URL the workers use to call back into Django.
DJANGO_INTERNAL_BASE_URL=http://localhost:8000

# --- Frontend --------------------------------------------------------------
FRONTEND_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_REALTIME_URL=http://localhost:4000

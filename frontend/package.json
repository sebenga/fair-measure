{
  "name": "fair-measure-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Ionic + Angular client for Fair Measure.",
  "engines": {
    "node": "^20.19.0 || ^22.12.0"
  },
  "scripts": {
    "start": "ng serve --port 8100",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:render": "node scripts/write-render-env.mjs && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "sync": "ionic build && npx cap sync"
  },
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/push-notifications": "^6.0.4",
    "@capacitor/status-bar": "^6.0.2",
    "@ionic/angular": "^8.4.0",
    "firebase": "^12.18.0",
    "ionicons": "^7.4.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@capacitor/cli": "^6.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.0"
  }
}
